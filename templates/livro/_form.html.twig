{{ form_start(form) }}
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.titulo) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.editora) }}
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        {{ form_row(form.edicao) }}
    </div>
    <div class="col-md-4 mb-3">
        {{ form_row(form.anoPublicacao) }}
    </div>
    <div class="col-md-4 mb-3">
        {{ form_row(form.valor) }}
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.autores) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.assuntos) }}
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
    <a href="{{ path('app_livro_index') }}" class="btn btn-light border">Cancelar</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> {{ button_label|default('Salvar Livro') }}
    </button>
</div>
{{ form_end(form) }}