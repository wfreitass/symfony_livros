{% extends 'base.html.twig' %}

{% block title %}Livros{% endblock %}

{% block body %}
<twig:PageHeader title="Acervo de Livros" subtitle="Listagem e gestão dos livros cadastrados no sistema"
    :actions="[{ label: 'Novo Livro', url: path('app_livro_new'), icon: 'bi-plus-lg', class: 'btn-primary' }]" />

<twig:Card title="Livros Cadastrados" icon="bi-book">
    <twig:Table
        :columns="[
            { label: 'Cód.', width: '70px' },
            { label: 'Título' },
            { label: 'Editora' },
            { label: 'Edição', class: 'text-center', width: '80px' },
            { label: 'Ano', class: 'text-center', width: '90px' },
            { label: 'Valor', class: 'text-end', width: '120px' },
            { label: 'Autores' },
            { label: 'Assuntos' },
            { label: 'Ações', class: 'text-end', width: '140px' }
        ]"
        :items="livros"
        emptyMessage="Nenhum livro cadastrado até o momento."
        emptyIcon="bi-journal-x"
    >
        {% for livro in livros %}
        <tr>
            <td class="fw-semibold text-muted">#{{ livro.id }}</td>
            <td class="fw-bold text-dark">{{ livro.titulo }}</td>
            <td>{{ livro.editora }}</td>
            <td class="text-center">{{ livro.edicao }}ª</td>
            <td class="text-center">{{ livro.anoPublicacao }}</td>
            <td class="text-end fw-bold text-success">{{ livro.valor|money_br }}</td>
            <td>
                {% for autor in livro.autores %}
                <span class="badge bg-secondary mb-1">{{ autor.nome }}</span>
                {% else %}
                <span class="text-muted small">Nenhum</span>
                {% endfor %}
            </td>
            <td>
                {% for assunto in livro.assuntos %}
                <span class="badge bg-info text-dark mb-1">{{ assunto.descricao }}</span>
                {% else %}
                <span class="text-muted small">Nenhum</span>
                {% endfor %}
            </td>
            <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                    <twig:Button href="{{ path('app_livro_edit', {'id': livro.id}) }}"
                        variant="outline-secondary" size="sm" icon="bi-pencil" title="Editar" />
                    <form method="post" action="{{ path('app_livro_delete', {'id': livro.id}) }}"
                        onsubmit="return confirm('Deseja realmente excluir este livro?');" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.id) }}">
                        <twig:Button type="submit" variant="outline-danger" size="sm" icon="bi-trash" title="Excluir" />
                    </form>
                </div>
            </td>
        </tr>
        {% endfor %}
    </twig:Table>

    <twig:Pagination :pagination="livros" itemName="livros" />
</twig:Card>
{% endblock %}