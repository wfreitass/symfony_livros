{% extends 'base.html.twig' %}

{% block title %}429 - Limite de Requisições Excedido{% endblock %}

{% block body %}
<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0 p-4">
            <div class="mb-3 text-warning">
                <i class="bi bi-hourglass-split display-1"></i>
            </div>
            <h2 class="h3 fw-bold mb-3">Muitas Requisições (429)</h2>
            <p class="text-muted mb-4">
                Você atingiu o limite de requisições permitidas para este recurso em um curto intervalo de tempo.
                Por favor, aguarde alguns instantes antes de tentar novamente.
            </p>
            <div>
                <a href="{{ path('app_home') }}" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Voltar para a Página Inicial
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
