{% extends 'base.html.twig' %}

{% block title %}Novo Autor{% endblock %}

{% block body %}
<twig:PageHeader title="Novo Autor" subtitle="Cadastrar um novo autor no sistema"
    :actions="[{ label: 'Voltar para Lista', url: path('app_autor_index'), icon: 'bi-arrow-left', class: 'btn-outline-secondary' }]" />

<div class="row justify-content-center">
    <div class="col-md-8">
        <twig:Card title="Dados do Autor" icon="bi-person-plus">
            {{ form_start(form) }}
            {{ form_row(form.nome) }}
            <div class="d-flex justify-content-end gap-2 mt-4">
                <twig:Button href="{{ path('app_autor_index') }}" variant="light" label="Cancelar" />
                <twig:Button type="submit" variant="success" icon="bi-check-lg" label="Salvar Autor" />
            </div>
            {{ form_end(form) }}
        </twig:Card>
    </div>
</div>
{% endblock %}