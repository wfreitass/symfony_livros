{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
<twig:PageHeader title="Autores" subtitle="Gerenciamento de autores cadastrados no acervo"
    :actions="[{ label: 'Novo Autor', url: path('app_autor_new'), icon: 'bi-plus-lg', class: 'btn-primary' }]" />

<twig:Card title="Lista de Autores" icon="bi-people">
    <twig:Table
        :columns="[
            { label: 'Código', width: '100px' },
            { label: 'Nome' },
            { label: 'Ações', class: 'text-end', width: '180px' }
        ]"
        :items="autores"
        emptyMessage="Nenhum autor cadastrado até o momento."
        emptyIcon="bi-inbox"
    >
        {% for autor in autores %}
        <tr>
            <td class="fw-semibold text-muted">#{{ autor.id }}</td>
            <td class="fw-bold">{{ autor.nome }}</td>
            <td class="text-end">
                <div class="d-flex justify-content-end gap-2">
                    <twig:Button href="{{ path('app_autor_edit', {'id': autor.id}) }}"
                        variant="outline-secondary" size="sm" icon="bi-pencil" title="Editar" />
                    <form method="post" action="{{ path('app_autor_delete', {'id': autor.id}) }}"
                        onsubmit="return confirm('Deseja realmente excluir este autor?');" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.id) }}">
                        <twig:Button type="submit" variant="outline-danger" size="sm" icon="bi-trash" title="Excluir" />
                    </form>
                </div>
            </td>
        </tr>
        {% endfor %}
    </twig:Table>

    {% if autores.getTotalItemCount() > 0 %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top gap-2">
        <div class="text-muted small">
            Mostrando <strong>{{ (autores.getCurrentPageNumber() - 1) * autores.getItemNumberPerPage() + 1 }}</strong> a <strong>{{ (autores.getCurrentPageNumber() - 1) * autores.getItemNumberPerPage() + autores|length }}</strong> de <strong>{{ autores.getTotalItemCount() }}</strong> autores
        </div>
        <div class="navigation mb-0">
            {{ knp_pagination_render(autores) }}
        </div>
    </div>
    {% endif %}
</twig:Card>
{% endblock %}