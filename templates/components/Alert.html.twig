{% props type = 'info', message = '', dismissible = true %}

<div class="alert alert-{{ type }} {{ dismissible ? 'alert-dismissible fade show' : '' }} d-flex align-items-center"
    role="alert">
    <div>{{ message }}</div>
    {% if dismissible %}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    {% endif %}
</div>