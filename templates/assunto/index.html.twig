{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}
<twig:PageHeader title="Assuntos" subtitle="Gerenciamento de assuntos e gêneros de livros"
    :actions="[{ label: 'Novo Assunto', url: path('app_assunto_new'), icon: 'bi-plus-lg', class: 'btn-primary' }]" />

<twig:Card title="Lista de Assuntos" icon="bi-tags">
    <twig:Table
        :columns="[
            { label: 'Código', width: '100px' },
            { label: 'Descrição' },
            { label: 'Ações', class: 'text-end', width: '180px' }
        ]"
        :items="assuntos"
        emptyMessage="Nenhum assunto cadastrado até o momento."
        emptyIcon="bi-inbox"
    >
        {% for assunto in assuntos %}
        <tr>
            <td class="fw-semibold text-muted">#{{ assunto.id }}</td>
            <td class="fw-bold">{{ assunto.descricao }}</td>
            <td class="text-end">
                <div class="d-flex justify-content-end gap-2">
                    <twig:Button href="{{ path('app_assunto_edit', {'id': assunto.id}) }}"
                        variant="outline-secondary" size="sm" icon="bi-pencil" title="Editar" />
                    <form method="post" action="{{ path('app_assunto_delete', {'id': assunto.id}) }}"
                        onsubmit="return confirm('Deseja realmente excluir este assunto?');" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assunto.id) }}">
                        <twig:Button type="submit" variant="outline-danger" size="sm" icon="bi-trash" title="Excluir" />
                    </form>
                </div>
            </td>
        </tr>
        {% endfor %}
    </twig:Table>

    {% if assuntos.getTotalItemCount() > 0 %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top gap-2">
        <div class="text-muted small">
            Mostrando <strong>{{ (assuntos.getCurrentPageNumber() - 1) * assuntos.getItemNumberPerPage() + 1 }}</strong> a <strong>{{ (assuntos.getCurrentPageNumber() - 1) * assuntos.getItemNumberPerPage() + assuntos|length }}</strong> de <strong>{{ assuntos.getTotalItemCount() }}</strong> assuntos
        </div>
        <div class="navigation mb-0">
            {{ knp_pagination_render(assuntos) }}
        </div>
    </div>
    {% endif %}
</twig:Card>
{% endblock %}