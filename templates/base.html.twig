<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestão de Livros{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
    {# O importmap('app') gerencia e carrega o Bootstrap, Icons, Stimulus e Chart.js locais #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Barra de Navegação -->
    <twig:Navbar />

    <!-- Container Principal -->
    <main class="container my-4 flex-grow-1">
        <!-- Mensagens Flash Globais -->
        {% for label, messages in app.flashes %}
        {% for message in messages %}
        <twig:Alert :type="label == 'error' ? 'danger' : label" :message="message" />
        {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
    <footer class="bg-white border-top py-3 mt-auto text-center text-muted small">
        <div class="container">
            <span>Sistema de Cadastro de Livros &copy; {{ "now"|date('Y') }} - Avaliação Técnica</span>
        </div>
    </footer>
    {% block extra_javascripts %}{% endblock %}
</body>

</html>