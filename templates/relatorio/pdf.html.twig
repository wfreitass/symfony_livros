<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Relatório de Livros por Autor</title>
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 11px;
            color: #333;
            margin: 20px;
        }

        .header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 18px;
            margin: 0;
            color: #0d6efd;
        }

        .header .meta {
            font-size: 9px;
            color: #777;
            margin-top: 5px;
        }

        .autor-section {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .autor-header {
            background-color: #f1f5f9;
            padding: 6px 10px;
            font-size: 13px;
            font-weight: bold;
            color: #1e293b;
            border-left: 4px solid #0d6efd;
            margin-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

        th {
            background-color: #f8fafc;
            border-bottom: 1px solid #cbd5e1;
            padding: 6px;
            text-align: left;
            font-size: 10px;
            text-transform: uppercase;
            color: #475569;
        }

        td {
            border-bottom: 1px solid #e2e8f0;
            padding: 6px;
            font-size: 10px;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .assunto-tag {
            background-color: #e2e8f0;
            padding: 2px 5px;
            border-radius: 3px;
            font-size: 9px;
            margin-right: 3px;
        }

        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 8px;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            padding-top: 5px;
        }
    </style>
</head>

<body>
    <div class="header">
        <h1>Sistema de Cadastro de Livros - Relatório por Autor</h1>
        <div class="meta">
            Consulta gerada a partir da VIEW SQL: <code>vw_relatorio_livros</code> | Data de emissão: {{
            geradoEm|date('d/m/Y H:i:s') }}
        </div>
    </div>

    {% for autor in dados %}
    <div class="autor-section">
        <div class="autor-header">
            Autor: {{ autor.nome }} ({{ autor.livros|length }} {{ autor.livros|length > 1 ? 'obras' : 'obra' }})
        </div>
        <table>
            <thead>
                <tr>
                    <th style="width: 40px;">Cód.</th>
                    <th>Título</th>
                    <th>Editora</th>
                    <th class="text-center" style="width: 40px;">Ed.</th>
                    <th class="text-center" style="width: 50px;">Ano</th>
                    <th class="text-right" style="width: 70px;">Valor</th>
                    <th>Assuntos</th>
                </tr>
            </thead>
            <tbody>
                {% for livro in autor.livros %}
                <tr>
                    <td>#{{ livro.id }}</td>
                    <td><strong>{{ livro.titulo }}</strong></td>
                    <td>{{ livro.editora }}</td>
                    <td class="text-center">{{ livro.edicao }}ª</td>
                    <td class="text-center">{{ livro.anoPublicacao }}</td>
                    <td class="text-right">{{ livro.valor|money_br }}</td>
                    <td>
                        {% for assunto in livro.assuntos %}
                        <span class="assunto-tag">{{ assunto }}</span>
                        {% else %}
                        -
                        {% endfor %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p style="text-align: center; color: #777; margin-top: 40px;">Nenhum registro encontrado na View de relatórios.</p>
    {% endfor %}

    <div class="footer">
        Documento gerado automaticamente pelo Sistema de Gestão de Livros
    </div>
</body>

</html>